# Publish only Android build configuration, the wrapper and authored app sources.
/android/*
!/android/build.gradle.kts
!/android/settings.gradle.kts
!/android/gradle.properties
!/android/gradlew
!/android/gradlew.bat
!/android/gradle/
/android/gradle/*
!/android/gradle/wrapper/
/android/gradle/wrapper/*
!/android/gradle/wrapper/gradle-wrapper.jar
!/android/gradle/wrapper/gradle-wrapper.properties
!/android/app/
/android/app/*
!/android/app/build.gradle.kts
!/android/app/src/

# Store materials may contain third-party map captures: separate rights review.
/android/store/
*.bundle

# Local secrets, generated output and location/evidence stores
.env*
!.env.example
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.apk
*.aab
**/local.properties
**/.gradle/
**/.kotlin/
**/.idea/
**/build/
/distribution/
**/node_modules/
server/data/
/server/data-local/
*.sqlite*
*.db
*.db-wal
*.db-shm
/data/
**/captures/
**/.cxx/
**/.externalNativeBuild/
*.hprof
*.log
.wrangler/
.DS_Store
