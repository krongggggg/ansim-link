# Copy to .env at the repository root. Replace the example hostname.
# Direct Node commands are run from server/; relative paths below use that directory.
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
PUBLIC_BASE_URL=https://family.example.com
# Optional: serve a separately supplied, redistributable Android client.
# The server runs without an APK; this repository contains no app source or binary.
ANDROID_APK_PATH=../distribution/ansim-link.apk

# Caddy production profile: public DNS must point to this host; ports 80/443 must be reachable.
DOMAIN=family.example.com

# Enable only behind a trusted reverse proxy with direct external access to 8080 blocked.
TRUST_PROXY=true
# HTTP is for isolated development only; keep false for production.
ALLOW_INSECURE_INVITES=false
